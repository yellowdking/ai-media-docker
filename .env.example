# 管理后台登录认证（留空 ADMIN_PASSWORD 则关闭后端鉴权）
ADMIN_USER=admin
ADMIN_PASSWORD=<replace-with-strong-random-password>
SESSION_SECRET=<replace-with-random-hex-secret>

# 可选：切换镜像源（默认拉取 ghcr.io/yellowdking/ai-media-docker:latest，也可改为 <dockerhub_user>/ai-media-server:latest）
# AI_MEDIA_IMAGE=ghcr.io/yellowdking/ai-media-docker:latest
