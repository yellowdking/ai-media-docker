# 管理后台登录认证（留空 ADMIN_PASSWORD 则关闭后端鉴权）
ADMIN_USER=admin
ADMIN_PASSWORD=<replace-with-strong-random-password>
SESSION_SECRET=<replace-with-random-hex-secret>

# 可选：切换镜像源（默认拉取 Docker Hub 镜像 bbplin/ai-media-server:latest，也可改为 GHCR 镜像 ghcr.io/yellowdking/ai-media-docker:latest）
# AI_MEDIA_IMAGE=bbplin/ai-media-server:latest
